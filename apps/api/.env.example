NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://embodha:embodha@localhost:5432/embodha

# 32+ random characters each. Generate with: openssl rand -base64 48
JWT_SECRET=
CODE_SECRET=

# The members' web app (the app's web build). The one-tap link in sign-in emails opens here, or opens the app on a
# phone that has it. Locally that's the web build on 8081; production refuses anything but https.
WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# The public website (apps/site). Optional: the launch checklist looks for its pages and its refund promise here.
SITE_URL=

# console prints sign-in codes to the API log (fine on your laptop, refused in production).
# Anywhere real, use smtp with Amazon SES or ZeptoMail on a dedicated sending domain.
MAIL_TRANSPORT=console
MAIL_FROM=Embodha <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where feedback from the app goes, besides admin's Feedback page. Replies go straight to the member.
FEEDBACK_EMAIL=
# Where the nightly money check writes when Razorpay's settlements don't match the books.
FINANCE_EMAIL=

# App Review account: this address always accepts this six-digit code and gets no email.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=

# Bunny Stream: Stream > your library > API.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# The library's CDN hostname, e.g. vz-1a2b3c4d-5e6.b-cdn.net
BUNNY_STREAM_CDN_HOST=
# Pull zone > Security > Token authentication key. Empty serves unsigned URLs (dev only).
BUNNY_STREAM_TOKEN_KEY=
# Any long random string. In Bunny, set the webhook URL to
# https://<your api host>/v1/webhooks/video?secret=<this value>
BUNNY_WEBHOOK_SECRET=

# Audio chapters. The API normalises loudness with ffmpeg (installed in the Docker image), then uploads the
# file to a Bunny Storage zone. Members play it through a pull zone on that storage, with token authentication.
BUNNY_STORAGE_ZONE=
# Storage zone > FTP & API access > Password
BUNNY_STORAGE_PASSWORD=
# The zone's region endpoint, e.g. sg.storage.bunnycdn.com for Singapore
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_AUDIO_CDN_HOST=
BUNNY_AUDIO_TOKEN_KEY=

# Offline downloads. Videos download as the MP4 copies Bunny makes when MP4 fallback is on in the library's Encoding
# settings (switch it on before uploading). Defaults: the link lasts 6 hours, downloads go on up to 3 phones per
# account, and play offline for 30 days after the phone was last online.
DOWNLOAD_URL_TTL_S=
DOWNLOAD_DEVICE_LIMIT=
DOWNLOAD_KEEP_DAYS=
# Development only: an MP4 for the dev seed's chapters to download, when DEV_SAMPLE_VIDEO_URL is an HLS stream.
DEV_SAMPLE_DOWNLOAD_URL=

# Private notes are encrypted with this key. Required in production; never change it once notes exist.
# openssl rand -base64 32
NOTES_KEY=

# Optional: Expo push access token, if "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Dev seed only (npm run db:seed:dev): the stream every dev chapter plays until real uploads replace it.
# Defaults to Mux's public test stream. Production never serves it.
DEV_SAMPLE_VIDEO_URL=

# Razorpay: Dashboard > Account & Settings > API keys. Empty keys switch checkout off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: point it at https://<api>/v1/webhooks/razorpay with the events payment.captured and refund.processed.
RAZORPAY_WEBHOOK_SECRET=

# App Store: App Store Connect > Users and Access > Integrations > In-App Purchase. Generate a key; the issuer ID is
# at the top of that page. Paste the .p8 file's text, with \n for line breaks if your host wants one line.
# Empty switches purchases in the iOS app off. Notifications: App Information > App Store Server Notifications,
# version 2, both URLs https://<api>/v1/webhooks/apple
APPLE_BUNDLE_ID=com.embodha.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Products made by the server: an App Store Connect API team key (Users and Access > Integrations > App Store Connect
# API, role App Manager). It's a different key from the In-App Purchase one above, from the same issuer.
APPLE_CONNECT_KEY_ID=
APPLE_CONNECT_PRIVATE_KEY=
# The app's Apple ID, the number under App Information. Looked up from the bundle ID if empty.
APPLE_APP_ID=
# How often unfinished products are retried and Apple's reviews checked, in minutes. 0 switches it off.
STORE_SYNC_MINUTES=30

# Google Play: a Google Cloud service account's JSON key (as is, or base64), invited in Play Console > Users and
# permissions with "View financial data", "Manage orders and subscriptions" and, for products made by the server,
# "Manage store presence". Empty switches Android purchases off.
GOOGLE_PLAY_PACKAGE_NAME=com.embodha.app
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Real-time developer notifications: a Pub/Sub push subscription to https://<api>/v1/webhooks/google?secret=<this>
# At least 16 random characters: openssl rand -hex 16
GOOGLE_PLAY_RTDN_SECRET=
