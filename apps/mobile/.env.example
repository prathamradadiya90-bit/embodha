# Copy to .env (Expo reads it on start). Restart `npx expo start` after changing it.

# The API the app talks to. In the browser on this computer, localhost is right. In the Android emulator it's
# http://10.0.2.2:3000; on a real phone, your computer's address on the Wi-Fi, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: where the public website (apps/site) is served, for the privacy policy and terms links, e.g.
# http://localhost:8090. Empty leaves the links out.
EXPO_PUBLIC_SITE_URL=
